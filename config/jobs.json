{
  "_note": "Michael Page 的搜索页可用；Robert Walters 返回403、Hiredly 搜索页靠JavaScript，都已关闭。",
  "keywords": [
    "export customer service",
    "export operations executive",
    "order management",
    "trade documentation",
    "import export customer service"
  ],
  "must_match_any": [
    "export",
    "customer service",
    "order management",
    "trade documentation",
    "customer care"
  ],
  "exclude_title": [
    "intern",
    "driver",
    "warehouse assistant",
    "forklift",
    "sales executive",
    "sales manager",
    "tamil",
    "hindi",
    "korean",
    "thai",
    "bahasa",
    "indonesian",
    "french",
    "japanese",
    "vietnamese",
    "german",
    "spanish",
    "arabic",
    "night shift",
    "onsite"
  ],
  "location_any": [
    "kuala lumpur",
    "wilayah persekutuan",
    "kl",
    "malaysia"
  ],
  "min_salary_month": 6000,
  "keep_unknown_salary": true,
  "max_age_days": 45,
  "max_links_per_source": 25,
  "delay_seconds": 2.0,
  "sources": [
    {
      "name": "Michael Page",
      "enabled": true,
      "search_urls": [
        "https://www.michaelpage.com.my/jobs/{kw_slug}"
      ],
      "link_pattern": "/job-detail/[^\"'#?\\s<>]+"
    },
    {
      "name": "Robert Walters",
      "enabled": false,
      "search_urls": [
        "https://www.robertwalters.com.my/supplychainprocurement/jobs/customerservice.html"
      ],
      "link_pattern": "/supplychainprocurement/jobs/[^\"'#?\\s<>/]+/\\d+-[^\"'#?\\s<>]+\\.html"
    },
    {
      "name": "Hiredly",
      "enabled": false,
      "search_urls": [
        "https://my.hiredly.com/jobs?search-term={kw}&location=Kuala+Lumpur"
      ],
      "link_pattern": "/jobs/jobs-malaysia-[a-z0-9\\-]+"
    },
    {
      "name": "Maukerja",
      "enabled": false,
      "search_urls": [],
      "link_pattern": ""
    }
  ],
  "seed_urls": [
    "https://my.hiredly.com/jobs/jobs-malaysia-fm-global-logistics-job-export-customer-service"
  ]
}
